# ---- secrets ----
.env
.env.*
!.env.example
*.key
credentials.json

# ---- DATASET (never commit: twcs.csv is ~493MB; GitHub hard-rejects >100MB) ----
# The official dataset stays local and is fetched by the reader via the README.
twcs/
twcs.csv
tws.csv

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---- generated caches ----
.cache/
scratch/
*.log

# The LLM response cache IS committed (D22, resolved). The assignment requires a
# grader to reproduce headline results in under 15 minutes, and a grader has no
# API key - replaying the cache is the only way that works. Note the pattern:
# `cache/*` rather than `cache/`, because git will not descend into an excluded
# directory, so a negation inside one would never match.
cache/*
!cache/llm/
# cache/corpus/ stays out: it is a 14 MB pickle rebuilt from twcs.csv in ~30 s.

# ---- generated evaluation outputs ----
outputs/
results/
runs/
reports/generated/
figures/

# Hand-labelled data and the final report are deliverables - keep them tracked.
!data/golden/
!data/golden/**

# ---- os ----
.DS_Store
Thumbs.db
desktop.ini
